{
  "name": "polito-apps",
  "private": true,
  "workspaces": [
    "students",
    "faculty",
    "base"
  ],
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "fixpilot": "node ./tools/fixpilot.js",
    "lint:check": "eslint --max-warnings=0 '**/*.{ts,tsx}'",
    "lint": "npm run lint:check -- --fix",
    "format:check": "prettier --check '**/*.{ts,tsx,md}'",
    "format": "prettier --write '**/*.{ts,tsx,md}'",
    "types:check": "npm run types:check --workspaces --if-present && npm run lib:check",
    "check": "npm run lint:check && npm run format:check && npm run types:check && npm run deps:check",
    "lib:check": "tsc -p lib/tsconfig.json --noEmit",
    "start:students": "npm start --workspace=students",
    "start:faculty": "npm start --workspace=faculty",
    "start:base": "npm start --workspace=base",
    "students:ios": "npm --workspace=students run ios",
    "students:android": "npm --workspace=students run android",
    "faculty:ios": "npm --workspace=faculty run ios",
    "faculty:android": "npm --workspace=faculty run android",
    "base:ios": "npm --workspace=base run ios",
    "base:android": "npm --workspace=base run android",
    "deps:check": "syncpack lint || echo \"Run 'npm run deps:fix' to fix dependency issues\"",
    "deps:fix": "syncpack fix",
    "postinstall": "npm run fixpilot -- --skip-modules --skip-derived",
    "prepare": "husky tools/.husky"
  },
  "dependencies": {
    "@fortawesome/free-brands-svg-icons": "^6.6.0",
    "@fortawesome/free-regular-svg-icons": "^6.6.0",
    "@fortawesome/free-solid-svg-icons": "^6.6.0",
    "color": "^4.2.3",
    "dom-serializer": "^2.0.0",
    "domhandler": "^5.0.3",
    "domutils": "^3.2.2",
    "geopoint": "^1.0.1",
    "htmlparser2": "^10.0.0",
    "lodash": "^4.17.21",
    "luxon": "^3.5.0",
    "semver": "^7.6.3",
    "superjson": "^2.2.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/plugin-proposal-export-namespace-from": "^7.18.9",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@commitlint/prompt-cli": "^17.5.0",
    "@react-native/babel-preset": "0.79.6",
    "@react-native/eslint-config": "0.79.6",
    "@react-native/metro-config": "0.79.6",
    "@react-native/typescript-config": "0.79.6",
    "@total-typescript/ts-reset": "^0.5.1",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/color": "^3.0.6",
    "@types/geojson": "^7946.0.16",
    "@types/geopoint": "^1.0.3",
    "@types/jest": "^29.5.1",
    "@types/lodash": "^4.17.9",
    "@types/luxon": "^3.4.2",
    "@types/node": "^16.11.65",
    "@types/react": "^19.0.0",
    "@types/react-native-html-to-pdf": "^0.8.3",
    "@types/react-test-renderer": "^18.0.0",
    "@types/uuid": "^10.0.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "eslint": "^8.19.0",
    "eslint-plugin-unused-imports": "^4.1.4",
    "husky": "^9.1.6",
    "jest": "^29.2.1",
    "lint-staged": "^15.2.10",
    "prettier": "^3.5.0",
    "react-test-renderer": "19.0.0",
    "syncpack": "^14.0.0-alpha.37",
    "typescript": "5.0.4"
  },
  "overrides": {
    "react-native": "0.79.6",
    "react": "19.0.0"
  }
}
