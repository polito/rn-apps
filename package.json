{
  "name": "polito-apps",
  "private": true,
  "workspaces": [
    "lib",
    "base",
    "students",
    "faculty"
  ],
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "fixpilot": "node ./tools/scripts/fixpilot.js",
    "lint:check": "eslint --max-warnings=0 '**/*.{ts,tsx}'",
    "lint": "npm run lint:check -- --fix",
    "knip": "knip --no-config-hints",
    "commit": "commit",
    "format:check": "prettier --check '**/*.{ts,tsx,md}'",
    "format": "prettier --write '**/*.{ts,tsx,md}'",
    "types:check": "npm run types:check --workspaces --if-present && npm run lib:check",
    "check": "npm run lint:check && npm run format:check && npm run types:check && npm run deps:check",
    "lib:check": "tsc -p lib/tsconfig.json --noEmit",
    "start:students": "npm start --workspace=students",
    "start:faculty": "npm start --workspace=faculty",
    "start:base": "npm start --workspace=base",
    "students:ios": "npm --workspace=students run ios",
    "students:android": "npm --workspace=students run android",
    "faculty:ios": "npm --workspace=faculty run ios",
    "faculty:android": "npm --workspace=faculty run android",
    "base:ios": "npm --workspace=base run ios",
    "base:android": "npm --workspace=base run android",
    "add": "node ./tools/scripts/installDeps.js",
    "remove": "node ./tools/scripts/manageDeps.js",
    "update": "node ./tools/scripts/manageDeps.js",
    "deps:check": "node ./tools/scripts/checkDeps.js",
    "deps:fix": "node ./tools/scripts/checkDeps.js -- --fix",
    "prepare": "husky tools/.husky",
    "postinstall": "npm run fixpilot -- --skip-modules --skip-derived"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@commitlint/prompt-cli": "^17.5.0",
    "@react-native/eslint-config": "0.81.5",
    "@react-native/typescript-config": "0.81.5",
    "@total-typescript/ts-reset": "^0.5.1",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/node": "^20.19.30",
    "@types/react": "^19.2.0",
    "commander": "^14.0.3",
    "eslint": "^8.19.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-react": "^7.30.1",
    "eslint-plugin-unused-imports": "^4.1.4",
    "husky": "^9.1.6",
    "knip": "^5.82.1",
    "lint-staged": "^15.2.10",
    "patch-package": "^8.0.1",
    "prettier": "^3.5.0",
    "typescript": "5.0.4"
  },
  "overrides": {
    "react-native": "0.83.10",
    "react": "19.2.0",
    "@types/react": "^19.2.0"
  },
  "dependencies": {
    "expo-constants": "~55.0.16",
    "expo-linking": "~55.0.16",
    "expo-router": "~55.0.16",
    "expo-status-bar": "~55.0.6",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0"
  }
}
