{
  "name": "@polito/students-app",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android --active-arch-only --appIdSuffix=dev ./students",
    "ios": "react-native run-ios --scheme='students dev' || echo 'If iOS startup fails, try running: npm run fixpilot'",
    "start": "react-native start --reset-cache",
    "test": "jest",
    "prepare": "husky",
    "commit": "commit",
    "lint:check": "eslint --max-warnings=0 '**/*.{ts,tsx}'",
    "lint": "npm run lint:check -- --fix",
    "format:check": "prettier --check '**/*.{ts,tsx,md}'",
    "format": "prettier --write '**/*.{ts,tsx,md}'",
    "types:check": "tsc --noEmit",
    "check": "npm run lint:check && npm run format:check && npm run types:check",
    "pod-install": "cd ios && bundle exec pod install"
  },
  "dependencies": {
    "@d11/react-native-fast-image": "^8.11.1",
    "@formatjs/intl-datetimeformat": "^6.16.5",
    "@formatjs/intl-getcanonicallocales": "^2.5.3",
    "@formatjs/intl-locale": "^4.2.5",
    "@gorhom/bottom-sheet": "^5.2.6",
    "@miblanchard/react-native-slider": "^2.6.0",
    "@noble/curves": "^2.0.1",
    "@noble/hashes": "^2.0.1",
    "@openspacelabs/react-native-zoomable-view": "^2.1.6",
    "@polito/api-client": "^2.2.6",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-clipboard/clipboard": "^1.16.3",
    "@react-native-community/blur": "^4.4.1",
    "@react-native-community/geolocation": "^3.4.0",
    "@react-native-community/netinfo": "^11.4.1",
    "@react-native-documents/picker": "^10.1.7",
    "@react-native-firebase/app": "^23.4.0",
    "@react-native-firebase/messaging": "^23.4.0",
    "@react-native-menu/menu": "^1.2.3",
    "@react-navigation/bottom-tabs": "^7.4.2",
    "@react-navigation/elements": "^2.5.2",
    "@react-navigation/material-top-tabs": "^7.3.2",
    "@react-navigation/native": "^7.1.18",
    "@react-navigation/native-stack": "^7.3.27",
    "@rnmapbox/maps": "^10.1.45",
    "@sentry/react-native": "^7.3.0",
    "@tanstack/query-async-storage-persister": "^5.90.2",
    "@tanstack/react-query-persist-client": "^5.90.2",
    "asn1js": "^3.0.6",
    "base32-encode": "^2.0.0",
    "expo": "~53.0.0",
    "expo-constants": "~17.1.7",
    "expo-web-browser": "^14.2.0",
    "react": "19.0.0",
    "react-native": "0.79.6",
    "react-native-animated-dots-carousel": "^1.0.2",
    "react-native-barcode-svg": "^0.0.15",
    "react-native-blob-util": "^0.19.11",
    "react-native-bootsplash": "^6.3.10",
    "react-native-chart-kit": "^6.12.0",
    "react-native-check-version": "^1.3.0",
    "react-native-context-menu-view": "^1.19.0",
    "react-native-date-picker": "5.0.12",
    "react-native-device-info": "^14.0.4",
    "react-native-dotenv": "^3.4.11",
    "react-native-edge-to-edge": "^1.6.2",
    "react-native-file-viewer": "^2.1.5",
    "react-native-fs": "^2.20.0",
    "react-native-gesture-handler": "^2.26.0",
    "react-native-get-random-values": "^1.11.0",
    "react-native-gifted-charts": "^1.4.58",
