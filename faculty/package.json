{
  "name": "@polito/faculty-app",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android --active-arch-only --appIdSuffix=dev ./faculty",
    "ios": "react-native run-ios || echo 'If iOS startup fails, try running: npm run fixpilot'",
    "start": "react-native start --reset-cache",
    "commit": "commit",
    "lint:check": "eslint --max-warnings=0 './**/*.{ts,tsx}'",
    "lint": "npm run lint:check -- --fix",
    "format:check": "prettier --check './**/*.{ts,tsx,md}' --ignore-path ../.prettierignore",
    "format": "prettier --write './**/*.{ts,tsx,md}' --ignore-path ../.prettierignore",
    "types:check": "tsc --noEmit",
    "check": "npm run lint:check && npm run format:check && npm run types:check",
    "pod-install": "cd ios && bundle exec pod install",
    "fixpilot": "node ../scripts/fixpilot.js"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^6.7.2",
    "@fortawesome/free-regular-svg-icons": "^6.6.0",
    "@fortawesome/free-solid-svg-icons": "^6.6.0",
    "@fortawesome/react-native-fontawesome": "^0.3.2",
    "@gorhom/bottom-sheet": "^5.2.6",
    "@polito/api-client": "^2.2.6",
    "@polito/lib": "1.0.0",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/blur": "^4.4.1",
    "@react-native-community/datetimepicker": "^8.3.0",
    "@react-native-menu/menu": "^1.2.3",
    "@react-navigation/bottom-tabs": "^7.4.2",
    "@react-navigation/elements": "^2.5.2",
    "@react-navigation/material-top-tabs": "^7.3.2",
    "@react-navigation/native": "^7.1.18",
    "@react-navigation/native-stack": "^7.3.27",
    "@rnmapbox/maps": "^10.1.45",
    "@sentry/react-native": "^7.3.0",
    "@tanstack/react-query": "^5.81.5",
    "date-fns": "^4.1.0",
    "expo": "~53.0.0",
    "i18next": "^23.16.4",
    "lodash": "^4.17.23",
    "luxon": "^3.7.2",
    "react": "19.0.0",
    "react-i18next": "^15.0.2",
    "react-native": "0.79.6",
    "react-native-animated-dots-carousel": "^1.0.2",
    "react-native-bootsplash": "^6.3.10",
    "react-native-device-info": "^14.0.4",
    "react-native-dotenv": "^3.4.11",
    "react-native-edge-to-edge": "^1.7.0",
    "react-native-fs": "^2.20.0",
    "react-native-gesture-handler": "^2.26.0",
    "react-native-localize": "^3.3.0",
    "react-native-modal": "^14.0.0-rc.1",
    "react-native-override-color-scheme": "^2.0.0",
    "react-native-pager-view": "^6.9.1",
    "react-native-permissions": "^5.4.2",
    "react-native-popover-view": "^6.1.0",
    "react-native-progress": "^5.0.1",
    "react-native-reanimated": "^3.19.2",
    "react-native-render-html": "^6.3.4",
    "react-native-safe-area-context": "^5.6.1",
    "react-native-screens": "^4.16.0",
    "react-native-svg": "^15.12.0",
    "use-latest-callback": "^0.2.4"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/plugin-proposal-export-namespace-from": "^7.18.9",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "18.0.0",
    "@react-native-community/cli-platform-android": "18.0.0",
    "@react-native-community/cli-platform-ios": "18.0.0",
    "@react-native/babel-preset": "0.79.6",
    "@react-native/metro-config": "0.79.6",
    "@types/geojson": "^7946.0.16",
    "@types/lodash": "^4.17.9",
    "@types/luxon": "^3.4.2",
    "@types/react": "^19.0.0",
    "babel-plugin-module-resolver": "^5.0.2"
  },
  "expo": {
    "autolinking": {
      "exclude": [
        "expo-application",
        "expo-asset",
        "expo-constants",
        "expo-file-system",
        "expo-font",
        "expo-keep-awake"
      ]
    }
  },
  "engines": {
    "node": ">=18"
  }
}
